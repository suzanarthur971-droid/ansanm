// Déploiement Cloudflare (Worker avec fichiers statiques).
// Le build Vite produit le site dans dist/ ; toute route inconnue renvoie l'app (React Router).
{
  "name": "ansanm",
  "compatibility_date": "2026-09-01",
  // Construit le site avant chaque déploiement, même si Cloudflare n'a pas de commande de build
  "build": { "command": "npm ci && npm run build" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
