// Déploiement Cloudflare (Worker avec fichiers statiques).
// Le build Vite produit le site dans dist/ ; toute route inconnue renvoie l'app (React Router).
{
  "name": "ansanm",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
